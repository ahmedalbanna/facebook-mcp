# ---- Facebook / Meta MCP server configuration ----
# Copy to .env and fill in. NEVER commit the real .env (it is git-ignored).
# Prefer the *_FILE variants (mode-600 files) for secrets in production.

# --- Auth (required) ---
# A long-lived access token. For Page/Messenger operations this should be a
# Page access token; for Marketing API, a user/system-user token with ads perms.
FB_ACCESS_TOKEN=
# Or read the token from a mode-600 file instead of the env (wins if set):
# FB_ACCESS_TOKEN_FILE=/run/secrets/fb_access_token

# App credentials — enable appsecret_proof (recommended) and debug_token.
FB_APP_ID=
FB_APP_SECRET=
# FB_APP_SECRET_FILE=/run/secrets/fb_app_secret

# Graph/Marketing API version.
FB_API_VERSION=v26.0

# --- Default object ids (optional; tools accept explicit ids too) ---
# Discover with: list_pages / list_ad_accounts / discover_ig_user.
FB_PAGE_ID=
FB_AD_ACCOUNT_ID=          # digits only or act_<digits>; normalised to act_...
FB_IG_USER_ID=
# FB_BUSINESS_ID=

# --- Write gating & ad-spend guardrails ---
# Writes are OFF by default. Turn on to expose create/update/delete/send tools.
FB_ENABLE_WRITES=false
# When true, write tools return a preview of the call instead of performing it.
FB_DRY_RUN=false
# Allow creating/activating ACTIVE ads objects (live spend). Off => forced PAUSED.
FB_ADS_ALLOW_ACTIVATE=false
# Budget caps in MINOR currency units (e.g. cents): 1000 == 10.00.
# Budgeted ads writes are refused until a cap is set.
FB_ADS_MAX_DAILY_BUDGET=0
FB_ADS_MAX_LIFETIME_BUDGET=0

# --- HTTP transport (only for --transport streamable-http) ---
# Static bearer token required on HTTP requests (optional).
FB_MCP_TOKEN=

# Request timeout (seconds).
FB_TIMEOUT=30

# --- Reports ---
# Directory the report tools may write files into (generate_campaign_report /
# generate_account_summary with save=true). Unset => reports can only be
# returned inline, never written to disk. Files are confined to this directory.
# FB_REPORT_DIR=/var/lib/facebook-mcp/reports

# --- Media ---
# Directory save_media may download media files into. Unset => save_media is
# refused (view_image / view_ig_media / view_ad_creative still return images
# inline without it). Files are confined to this directory (basename only).
# FB_MEDIA_DIR=/var/lib/facebook-mcp/media

# ---- Token scopes by surface (grant on the token you use) ----
# Pages:      pages_show_list, pages_read_engagement, pages_manage_posts,
#             pages_manage_engagement, read_insights
# Ads:        ads_read, ads_management, business_management
# Instagram:  instagram_basic, instagram_content_publish,
#             instagram_manage_comments, instagram_manage_insights, pages_show_list
# Messenger:  pages_messaging, pages_manage_metadata
